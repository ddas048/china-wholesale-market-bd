// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MERCHANT
  ADMIN
  // Add other roles as needed
}

model User {
  id           String    @id @unique
  firstName    String
  lastName     String
  email        String    @unique
  username     String    @unique
  photo        String
  role         UserRole  @default(USER)
  storeId      String?
  isSubscribed Boolean   @default(false)
  isVerified   Boolean   @default(false)
  subStartDate DateTime?
  subEndDate   DateTime?
  lastLoginAt  DateTime?

  comments Comment[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id           String   @id @unique
  uerId        String
  name         String
  address      String
  storeAddress String
  cotactNumber Int
  location     String
  isVerified   Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id             String   @id @unique
  userId         String
  User           User     @relation(fields: [userId], references: [id])
  orderDate      DateTime
  deliveryStatus String
  totalAmount    Int
  paymentMethod  String
  couponCode     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Orderdetail {
  id        String   @id @unique
  orderId   String
  productId String
  quantity  Int
  price     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String   @id @unique
  storeId       String
  name          String
  description   String
  category      String
  stockQuantity Int
  price         Int
  averageRating Int
  slug          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Comment {
  id          String   @id @unique
  userId      User[]
  productId   String
  commentText String
  imageUrl    String
  rating      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deliveryservic {
  id           String   @id @unique
  accessToken  String?
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Analytics
model User_Session {
  id         String   @id @unique
  userId     String
  startTime  DateTime
  endTime    DateTime
  deviceInfo String
  ipAddress  String
}

model Product_View {
  id        String   @id @unique
  productId String
  userId    String
  viewedAt  DateTime
  sourceUrl String
}

model Cart_Item {
  id        String   @id @unique
  userId    String
  productId String
  quantity  Int
  addedAt   DateTime
  updatedAt DateTime
}

